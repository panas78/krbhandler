[Desktop Entry]
Type=Application
Name=Kerberos Tickets
GenericName=Kerberos Ticket Manager
Comment=Keep your Kerberos ticket alive and see when it expires
Exec=@BINDIR@/krbctl window
TryExec=@BINDIR@/krbctl
Icon=krbctl
Terminal=false
Categories=System;Security;
Keywords=kerberos;kinit;ticket;krb5;renew;cerberus;
StartupNotify=true
StartupWMClass=io.github.pan.Krbctl
X-GNOME-UsesNotifications=true
